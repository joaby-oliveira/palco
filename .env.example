# Copie para .env (no notebook) ou /opt/palco/.env (no servidor) e preencha.
# Cobrança (passe por festa e planos mensais). Sem BILLING=1, tudo fica liberado.
BILLING=1
BILLING_PROVIDER=abacatepay
# AbacatePay: chave em Integrar › API Keys (abc_dev_ = modo dev)
ABACATEPAY_API_KEY=
# Segredo do webhook (o mesmo cadastrado no AbacatePay)
ABACATEPAY_WEBHOOK_SECRET=
# Asaas (ASAAS_SANDBOX=1 usa o ambiente de testes)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX=1
# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
